# Copy to .env for local development. In Cloud Run, set these as env vars / Secret Manager secrets.

ENVIRONMENT=development

# Local: SQLite file. Production: Neon pooled connection string, using the psycopg driver, e.g.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/meetings?sslmode=require
DATABASE_URL=sqlite:///./meetings.db

# At least 32 random characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-change-me-change-me-change-me

# Speech-to-text (OpenAI-compatible). Groq's hosted Whisper by default.
TRANSCRIPTION_API_KEY=
# TRANSCRIPTION_BASE_URL=https://api.groq.com/openai/v1
# TRANSCRIPTION_MODEL=whisper-large-v3
# TRANSCRIPTION_LANGUAGE=ar

# Summarizer (OpenAI-compatible). DeepSeek by default.
LLM_API_KEY=
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-chat

# MAX_UPLOAD_MB=30
# MAX_AUDIO_MINUTES=180
