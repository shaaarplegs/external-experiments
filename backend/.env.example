# Copy to .env for local development. In Cloud Run these come from Secret Manager.
# Provider API keys, models, the summary prompt and limits are NOT set here: an admin sets
# them in the app (PATCH /admin/settings) and they are stored, encrypted, in the database.

ENVIRONMENT=development

# PostgreSQL. Local: `docker compose up -d db`. Production: Neon's pooled connection string, e.g.
# postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.eu-central-1.aws.neon.tech/meetings?sslmode=require
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/meetings

# Signs login tokens and encrypts the API keys stored in the database. At least 32 characters:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-change-me-change-me-change-me
